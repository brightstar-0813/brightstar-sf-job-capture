# Slack Incoming Webhook (optional — skip notify if empty)
SLACK_WEBHOOK_URL=

# Local API (npm start)
PORT=3847

# Capture settings
SEARCH_Q=Salesforce
MAX_PAGES=5
PAGE_SIZE=20
HEADLESS=true
DELAY_MS=800
CRON_SCHEDULE=0 5,17 * * *

# Sources
CAPTURE_DICE=true
# false = JobRight via Chrome extension (recommended). true = Playwright + jobright:login
CAPTURE_JOBRIGHT=false
JOBRIGHT_MAX_PAGES=5
JOBRIGHT_AUTH_PATH=download/jobright-auth.json

# Paths (relative to project root)
DATA_DIR=download
CSV_PREFIX_DICE=dice_sf_jobs
CSV_PREFIX_JOBRIGHT=jobright_sf_jobs
CSV_LATEST_DICE=dice_jobs_latest.csv
CSV_LATEST_JOBRIGHT=jobright_jobs_latest.csv
STORE_FILE=store.json
