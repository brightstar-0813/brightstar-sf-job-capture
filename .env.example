# Slack Incoming Webhook (optional — skip notify if empty)
SLACK_WEBHOOK_URL=

# Local API (npm start)
PORT=3847

# Capture settings
SEARCH_Q=Salesforce
MAX_PAGES=8
SEARCH_EXTRA_PAGES=3
PAGE_SIZE=50
HEADLESS=true
DELAY_MS=800
CRON_SCHEDULE=0 */8 * * *
RECENT_DAYS=7

# Sources
CAPTURE_DICE=true
# false = JobRight via Chrome extension (recommended). true = Playwright + jobright:login
CAPTURE_JOBRIGHT=false
CAPTURE_INDEED=false
CAPTURE_CAREERBUILDER=true
CAPTURE_HIMALAYAS=true
CAPTURE_JOBGETHER=true
CAPTURE_ARBEITNOW=true
CAPTURE_GOOGLEJOBS=true
# Google Jobs has no free public API. Optional paid aggregator:
# SERPAPI_KEY=
INDEED_AUTH_PATH=download/indeed-auth.json
INDEED_PROFILE_DIR=download/indeed-profile
JOBRIGHT_MAX_PAGES=5
JOBRIGHT_AUTH_PATH=download/jobright-auth.json

# Bid tracker (applied / resume-built). Capture skips matching job Links only.
# Sheet must be shared as "Anyone with the link can view".
EXCLUDE_BID_TRACKING_SHEET=true
BID_TRACKING_SHEET_URL=https://docs.google.com/spreadsheets/d/1UCHuLKjnEDvH-Q8NYBvspmyts0evq2lFT5ZQF_djmcE/edit?gid=0#gid=0
BID_TRACKING_SHEET_GID=0

# Paths (relative to project root)
DATA_DIR=download
CSV_PREFIX_DICE=dice_sf_jobs
CSV_PREFIX_JOBRIGHT=jobright_sf_jobs
CSV_LATEST_DICE=dice_jobs_latest.csv
CSV_LATEST_JOBRIGHT=jobright_jobs_latest.csv
STORE_FILE=store.json
