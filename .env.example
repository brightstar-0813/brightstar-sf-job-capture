# Slack Incoming Webhook (optional — skip notify if empty)
SLACK_WEBHOOK_URL=

# Local API (npm start)
PORT=3847

# Capture settings
SEARCH_Q=Salesforce
MAX_PAGES=8
SEARCH_EXTRA_PAGES=3
PAGE_SIZE=50
HEADLESS=true
DELAY_MS=800
CRON_SCHEDULE=0 5,17 * * *
RECENT_DAYS=7

# Sources
CAPTURE_DICE=true
# JobRight: /swan API with the saved login (npm run jobright:login, ~60-day session).
# No/expired session -> automatic anonymous fallback (public pages, newest ~20 per title,
# ~30 titles per run before JobRight's rate-limit challenge). Capture warns loudly when this happens.
CAPTURE_JOBRIGHT=true
CAPTURE_BUILTIN=true
CAPTURE_GREENHOUSE=true
CAPTURE_LEVER=true
CAPTURE_ASHBY=true
# Public JSON/RSS APIs (preferred — no browser)
CAPTURE_REMOTIVE=true
CAPTURE_JOBICY=true
CAPTURE_REMOTEOK=true
CAPTURE_WWR=true
CAPTURE_HIMALAYAS=true
CAPTURE_JOBGETHER=true
CAPTURE_ARBEITNOW=true
# The Muse public API now 404s / is Cloudflare-blocked.
CAPTURE_THEMUSE=false
CAPTURE_WORKINGNOMADS=true
CAPTURE_JOBSPRESSO=true
CAPTURE_SKIPTHEDRIVE=true
CAPTURE_ARC=true
CAPTURE_USAJOBS=true
CAPTURE_ADZUNA=true
CAPTURE_GOOGLEJOBS=true
# Optional aggregator / federal APIs (free registration):
# USAJOBS_API_KEY=
# USAJOBS_USER_EMAIL=you@example.com
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# Indeed via mobile GraphQL API (no browser/login). INDEED_MODE=browser = legacy Playwright scrape.
# Searches SEARCH_QUERIES (multi-word seeds are phrase-quoted), 100 per page.
CAPTURE_INDEED=true
INDEED_MODE=api
INDEED_MAX_PAGES=5
# SimplyHired via Python curl_cffi helper (scripts/simplyhired_fetch.py). Setup: npm run py:setup
CAPTURE_SIMPLYHIRED=true
# PYTHON_BIN=.venv-jobspy/Scripts/python.exe
# SIMPLYHIRED_QUERIES=   (default: ROLE_TITLES)
SIMPLYHIRED_PAGES=1
# Playwright boards bot-blocked in headless (Cloudflare / DataDome) — use the Chrome extension.
CAPTURE_ZIPRECRUITER=false
CAPTURE_MONSTER=false
CAPTURE_CAREERBUILDER=false
# Google Jobs has no free public API. Optional paid aggregator:
# SERPAPI_KEY=
JOBICY_TAGS=salesforce,crm,mulesoft,apex
INDEED_AUTH_PATH=download/indeed-auth.json
INDEED_PROFILE_DIR=download/indeed-profile
JOBRIGHT_MAX_PAGES=5
JOBRIGHT_AUTH_PATH=download/jobright-auth.json

# Bid tracker (applied / resume-built). Capture skips matching job Links only.
# Sheet must be shared as "Anyone with the link can view".
EXCLUDE_BID_TRACKING_SHEET=true
BID_TRACKING_SHEET_URL=https://docs.google.com/spreadsheets/d/1UCHuLKjnEDvH-Q8NYBvspmyts0evq2lFT5ZQF_djmcE/edit?gid=0#gid=0
BID_TRACKING_SHEET_GID=0

# Append newly captured jobs to US-SF-Jobs (warehouse) via Apps Script web app.
# Columns: Role | Company | Link | JD | Salary  (no Ready / Auto bid)
# Redeploy apps-script/Code.gs after updates (action: appendWarehouse).
SYNC_JOBS_SHEET=true
JOBS_SHEET_WEBAPP_URL=https://script.google.com/macros/s/AKfycbwH-J2wyqDDIio8Aue7Afq_WZkn1-SBcJ8l2RH2dzCbMk6hZelVXyREOm6fiE9Eujrl/exec
JOBS_SHEET_URL=https://docs.google.com/spreadsheets/d/1UCHuLKjnEDvH-Q8NYBvspmyts0evq2lFT5ZQF_djmcE/edit?gid=1039755249#gid=1039755249
JOBS_SHEET_NAME=US-SF-Jobs

# Paths (relative to project root)
DATA_DIR=download
CSV_LATEST_FILE=jobs_latest.csv
# Also written each sync: download/NN_{source}_jobs_latest.csv (01_builtin, 02_himalayas, 03_greenhouse, 04_dice, …)
# and download/07_workday_jobs_latest.csv (Workday apply URLs from any source). Rows include seq=1…n.
CSV_PREFIX_DICE=dice_sf_jobs
CSV_PREFIX_JOBRIGHT=jobright_sf_jobs
STORE_FILE=store.json
