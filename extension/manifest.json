{
  "manifest_version": 3,
  "name": "Salesforce Remote Job Capture",
  "description": "Headless JobRight capture using your logged-in Chrome session. Runs every 8 hours; click the icon to run now. Jobs land in jobs_latest.csv via the local API.",
  "version": "1.5.2",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:3847/*",
    "http://localhost:3847/*",
    "https://jobright.ai/*",
    "https://www.jobright.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://jobright.ai/*", "https://www.jobright.ai/*"],
      "js": ["jobright-content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Salesforce Job Capture — click to run JobRight now",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
