{
  "manifest_version": 3,
  "name": "Salesforce Remote Job Capture",
  "description": "Logged-in Chrome DOM capture for Indeed / ZipRecruiter / Monster / CareerBuilder / JobRight. Parallel to Node API capture — select sources in the popup. Jobs ingest via local API → jobs_latest.csv.",
  "version": "2.0.0",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:3847/*",
    "http://localhost:3847/*",
    "https://jobright.ai/*",
    "https://www.jobright.ai/*",
    "https://www.indeed.com/*",
    "https://indeed.com/*",
    "https://www.ziprecruiter.com/*",
    "https://ziprecruiter.com/*",
    "https://www.monster.com/*",
    "https://monster.com/*",
    "https://www.careerbuilder.com/*",
    "https://careerbuilder.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Salesforce Job Capture",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://jobright.ai/*", "https://www.jobright.ai/*"],
      "js": ["adapters/jobright-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.indeed.com/*", "https://indeed.com/*"],
      "js": [
        "lib/protocol.js",
        "lib/filter-lite.js",
        "lib/dom-runner.js",
        "adapters/indeed-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ziprecruiter.com/*",
        "https://ziprecruiter.com/*"
      ],
      "js": [
        "lib/protocol.js",
        "lib/filter-lite.js",
        "lib/dom-runner.js",
        "adapters/ziprecruiter-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.monster.com/*", "https://monster.com/*"],
      "js": [
        "lib/protocol.js",
        "lib/filter-lite.js",
        "lib/dom-runner.js",
        "adapters/monster-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.careerbuilder.com/*",
        "https://careerbuilder.com/*"
      ],
      "js": [
        "lib/protocol.js",
        "lib/filter-lite.js",
        "lib/dom-runner.js",
        "adapters/careerbuilder-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
